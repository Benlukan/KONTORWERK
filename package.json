{
  "name": "kontorwerk",
  "version": "2.1.0",
  "private": true,
  "description": "KONTORWERK – modulares ERP für Maker: Warenwirtschaft, Verkauf, Kontakte und mehr",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
